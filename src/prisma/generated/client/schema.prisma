// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                   @id @default(cuid())
  username          String                   @unique
  email             String?                  @unique
  password          String?
  roles             Role[]                   @default([USER])
  status            Status                   @default(PENDING)
  invitationToken   String?                  @unique
  profilePicture    String? // URL to profile picture
  bio               String? // User biography
  location          String? // User location
  phoneNumber       String? // User phone number
  socialLinks       Json? // Social media links
  notificationPrefs NotificationPreferences?
  sessions          Session[] // User sessions
  darkMode          Boolean                  @default(false) // Theme preference
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  news              News[]
  drafts            Draft[]
  tasks             Task[]                   @relation("AssignedTasks")
  createdTasks      Task[]                   @relation("CreatedTasks")
  activities        Activity[]
  teams             Team[]                   @relation("TeamManagers")
  managedGames      GameManager[]
  playerNotes       PlayerNote[]
  events            Event[]                  @relation("UserEvents")
  mediaItems        MediaItem[]
  player            Player?
}

model NotificationPreferences {
  id                   String   @id @default(cuid())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String   @unique
  emailNotifications   Boolean  @default(true)
  newsUpdates          Boolean  @default(true)
  teamUpdates          Boolean  @default(true)
  matchReminders       Boolean  @default(true)
  discordNotifications Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  token      String   @unique
  userAgent  String?
  ipAddress  String?
  lastActive DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

enum Role {
  USER
  PLAYER
  NEWS_WRITER
  TEAM_MANAGER
  ADMIN
}

enum Status {
  PENDING
  ACTIVE
  DISABLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assignedTo  User       @relation("AssignedTasks", fields: [userId], references: [id])
  userId      String
  createdBy   User       @relation("CreatedTasks", fields: [creatorId], references: [id])
  creatorId   String
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  message   String
  metadata  Json?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id])
  userId    String
}

enum ActivityType {
  NEWS_CREATED
  NEWS_UPDATED
  ROSTER_CHANGED
  TASK_CREATED
  TASK_UPDATED
  USER_ROLE_CHANGED
  DRAFT_CREATED
  DRAFT_UPDATED
  DRAFT_PUBLISHED
  MEDIA_UPLOADED
  PLAYER_ADDED
  PLAYER_UPDATED
}

model Team {
  id        String   @id @default(cuid())
  name      String
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  managers  User[]   @relation("TeamManagers")
  players   Player[] @relation("PlayerTeams")
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  events    Event[]  @relation("TeamEvents")
}

model Game {
  id        String        @id @default(cuid())
  name      String        @unique
  teams     Team[]
  managers  GameManager[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model GameManager {
  id        String   @id @default(cuid())
  game      Game     @relation(fields: [gameId], references: [id])
  gameId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, userId])
}

model Player {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  inGameName   String
  username     String?      @unique
  dateOfBirth  DateTime?
  country      String?
  teams        Team[]       @relation("PlayerTeams")
  role         String?
  rank         String?
  joinDate     DateTime     @default(now())
  endDate      DateTime?
  socialLinks  Json?
  trackerLinks Json?
  stats        PlayerStats?
  contracts    Contract[]
  notes        PlayerNote[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?      @unique
}

model PlayerStats {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String   @unique
  stats     Json // Store game-specific stats
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  startDate DateTime
  endDate   DateTime
  terms     String? // Contract terms or notes
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlayerNote {
  id        String   @id @default(cuid())
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  isPrivate Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id       String    @id @default(cuid())
  type     MatchType
  team     Team      @relation(fields: [teamId], references: [id])
  teamId   String
  opponent String
  date     DateTime
  result   String?
  notes    String?
}

enum MatchType {
  TOURNAMENT
  SCRIM
  OFFICIAL
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  priority  Priority  @default(MEDIUM)
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)
}

model News {
  id              String      @id @default(cuid())
  title           String
  content         String
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  publishedAt     DateTime?
  tags            Tag[]
  featuredImage   MediaItem?  @relation(fields: [featuredImageId], references: [id])
  featuredImageId String?     @unique
  mediaItems      MediaItem[] @relation("NewsMedia")
}

model Tag {
  id     String  @id @default(cuid())
  name   String  @unique
  news   News[]
  drafts Draft[]
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean   @default(false)
  type        EventType
  team        Team?     @relation(fields: [teamId], references: [id], name: "TeamEvents")
  teamId      String?
  createdBy   User      @relation(fields: [createdById], references: [id], name: "UserEvents")
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum EventType {
  MATCH
  PRACTICE
  TOURNAMENT
  MEETING
  OTHER
}

model Draft {
  id              String      @id @default(cuid())
  title           String
  content         String
  authorId        String
  author          User        @relation(fields: [authorId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tags            Tag[]
  featuredImage   MediaItem?  @relation(fields: [featuredImageId], references: [id])
  featuredImageId String?     @unique
  mediaItems      MediaItem[] @relation("DraftMedia")
  status          DraftStatus @default(IN_PROGRESS)
  reviewNotes     String?
  reviewerId      String?
}

enum DraftStatus {
  IN_PROGRESS
  READY_FOR_REVIEW
  NEEDS_REVISION
  APPROVED
}

model MediaItem {
  id                   String    @id @default(cuid())
  filename             String
  originalFilename     String
  path                 String
  url                  String
  type                 MediaType
  size                 Int
  mimeType             String
  width                Int?
  height               Int?
  duration             Float? // For videos/audio in seconds
  alt                  String?
  caption              String?
  uploadedBy           User      @relation(fields: [uploadedById], references: [id])
  uploadedById         String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tags                 String[]
  folder               String?
  featuredInNews       News[]    @relation("NewsMedia")
  featuredAsNewsImage  News?
  featuredInDrafts     Draft[]   @relation("DraftMedia")
  featuredAsDraftImage Draft?
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}
